<Window
    x:Class="IzekipShell.Views.UpdatingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Guncelleme sirasinda tek basina calisan minimal ekran. Kabugun geri kalani
          (gorev cubugu, Baslat, masaustu...) bu sirada tamamen kapali; dosyalar
          serbestken sadece bu pencere ayakta kalir.  -->
    <Grid
        x:Name="Root"
        Width="360"
        Height="210"
        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="18">
            <ProgressRing
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                IsActive="True" />
            <StackPanel HorizontalAlignment="Center" Spacing="4">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Explorer33 güncelleniyor" />
                <TextBlock
                    x:Name="StatusText"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Hazırlanıyor…" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
