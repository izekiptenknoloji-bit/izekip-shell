<Window
    x:Class="IzekipShell.Views.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:IzekipShell.Services">

    <!--  Denetim merkezi: saat, hizli ayarlar, ses, durum ve takvim tek panelde  -->
    <Grid x:Name="Root" KeyDown="Root_KeyDown">
        <ScrollViewer x:Name="MainView" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,22,24,24" Spacing="18">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Hızlı ayarlar" />

                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button x:Name="WifiTile" Click="WifiTile_Click" Style="{StaticResource QuickTileStyle}">
                        <StackPanel Spacing="6">
                            <FontIcon HorizontalAlignment="Left" FontSize="18" Glyph="&#xE701;" />
                            <TextBlock x:Name="WifiTileText" FontSize="12" Text="Wi-Fi" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Click="Quick_Click" Style="{StaticResource QuickTileStyle}" Tag="ms-settings:bluetooth">
                        <StackPanel Spacing="6">
                            <FontIcon HorizontalAlignment="Left" FontSize="18" Glyph="&#xE702;" />
                            <TextBlock FontSize="12" Text="Bluetooth" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Click="Quick_Click" Style="{StaticResource QuickTileStyle}" Tag="ms-settings:display">
                        <StackPanel Spacing="6">
                            <FontIcon HorizontalAlignment="Left" FontSize="18" Glyph="&#xE7F4;" />
                            <TextBlock FontSize="12" Text="Ekran" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="1" Click="Quick_Click" Style="{StaticResource QuickTileStyle}" Tag="ms-settings:personalization-background">
                        <StackPanel Spacing="6">
                            <FontIcon HorizontalAlignment="Left" FontSize="18" Glyph="&#xE771;" />
                            <TextBlock FontSize="12" Text="Kişiselleştir" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="1" Grid.Column="1" Click="Quick_Click" Style="{StaticResource QuickTileStyle}" Tag="taskmgr.exe">
                        <StackPanel Spacing="6">
                            <FontIcon HorizontalAlignment="Left" FontSize="18" Glyph="&#xE9D9;" />
                            <TextBlock FontSize="12" Text="Görevler" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="1" Grid.Column="2" Click="Quick_Click" Style="{StaticResource QuickTileStyle}" Tag="ms-settings:">
                        <StackPanel Spacing="6">
                            <FontIcon HorizontalAlignment="Left" FontSize="18" Glyph="&#xE713;" />
                            <TextBlock FontSize="12" Text="Ayarlar" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!--  Ses  -->
                <Border
                    Padding="8,6,16,6"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="MuteButton"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Click="Mute_Click"
                            Style="{StaticResource TaskButtonStyle}"
                            ToolTipService.ToolTip="Sesi aç/kapat">
                            <FontIcon x:Name="VolumeIcon" FontSize="16" Glyph="&#xE995;" />
                        </Button>
                        <Slider
                            x:Name="VolumeSlider"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Maximum="100"
                            Minimum="0"
                            ValueChanged="Volume_ValueChanged" />
                        <TextBlock
                            x:Name="VolumeText"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            TextAlignment="Right" />
                    </Grid>
                </Border>

                <!--  Ag ve pil  -->
                <Border
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="NetIcon" FontSize="16" Glyph="&#xE701;" />
                            <TextBlock
                                x:Name="NetText"
                                Grid.Column="1"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Grid
                            x:Name="BatteryRow"
                            ColumnSpacing="14"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="BatteryIcon" FontSize="16" />
                            <TextBlock x:Name="BatteryText" Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!--  Wi-Fi sayfasi  -->
        <Grid
            x:Name="WifiView"
            Padding="16,18,16,16"
            RowSpacing="12"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Width="36" Height="36" Padding="0" Click="WifiBack_Click" Style="{StaticResource TaskButtonStyle}" ToolTipService.ToolTip="Geri">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="Wi-Fi" />
                <Button Grid.Column="2" Width="36" Height="36" Padding="0" Click="WifiRefresh_Click" Style="{StaticResource TaskButtonStyle}" ToolTipService.ToolTip="Yeniden tara">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </Grid>
            <ProgressBar x:Name="WifiProgress" Grid.Row="1" IsIndeterminate="True" Visibility="Collapsed" />

            <ListView
                x:Name="WifiList"
                Grid.Row="2"
                Margin="-4,0"
                IsItemClickEnabled="True"
                ItemClick="Wifi_ItemClick"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="svc:WifiNetwork">
                        <Grid Height="52" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="18" Glyph="{x:Bind Glyph}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Ssid}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Status}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE72E;" Visibility="{x:Bind Secured}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Secili ag: sifre ve baglan  -->
            <Border
                x:Name="ConnectCard"
                Grid.Row="3"
                Padding="16,14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="ConnectTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <PasswordBox x:Name="WifiPassword" KeyDown="WifiPassword_KeyDown" PlaceholderText="Ağ güvenlik anahtarı" />
                    <TextBlock x:Name="ConnectError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ConnectButton" HorizontalAlignment="Stretch" Click="Connect_Click" Content="Bağlan" Style="{StaticResource AccentButtonStyle}" />
                        <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="WifiSettings_Click" Content="Ağ ayarları" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
